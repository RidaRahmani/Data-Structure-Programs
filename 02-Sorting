#include <stdio.h>
int main()
{
 int roll[20],ch,i,k,j,n,temp;
 do{
    printf("\n\n1-Accept roll no");
    printf("\n2-Sort in ascending order and print intermediate passes");
    printf("\n3-Display sorted roll nos");
    printf("\n4-Exit");
    printf("\nEnter your choice: ");
    scanf("%d",&ch);
   
   switch(ch)
   {
   case 1:
       //Accept roll no
       printf("\nEnter number of elements");
       scanf("%d",&n);
       for (i=0;i<n;i++){
           printf("\nEnter value");
           scanf("%d",&roll[i]);
       }
   break;
   
   case 2:
       //Sort in ascending order
       for(i=0;i<=n-2;i++)
       {
           for(j=0;j<=(n-i-2);j++)
           {
                if (roll[j]>roll[j+1])
                {
                   temp=roll[j];
                   roll[j]=roll[j+1];
                   roll[j+1]=temp;
                }
          }
          printf("\n Pass %d:",i);
          for(k=0;k<n;k++)
             {printf("\n %d",roll[k]);
             }
       }
       printf("\nNumbers sorted successfully");
   break;
   
   case 3:
       //Display sorted roll nos
       for(i=0;i<n;i++){
              printf("\n%d",roll[i]);
      }
   break;
  }
  }
  while(ch!=4);
  
return 0;
}
